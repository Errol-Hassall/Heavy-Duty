{
  "name": "heavy-duty",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "bun .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "bun run typecheck && bun run lint && bun run test && bun run test:e2e",
    "db:reset": "bun -e \"import fs from 'node:fs'; for (const f of ['data/heavy-duty.db','data/heavy-duty.db-wal','data/heavy-duty.db-shm']) fs.rmSync(f,{force:true})\""
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "@tanstack/react-store": "^0.11.2",
    "lucide-react": "^1.74.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  }
}
